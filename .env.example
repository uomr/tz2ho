# ======================================================
# RuknAuto — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم
# ======================================================

# قاعدة البيانات PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruknauto

# مفتاح OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# سر الجلسة (أي نص عشوائي طويل)
SESSION_SECRET=change-this-to-a-random-secret-string
